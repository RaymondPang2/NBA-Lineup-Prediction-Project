# Copy to .env.local (git-ignored). Base URL of the FastAPI service, including the /api/v1 prefix.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Optional, private/local builds only: team logo URL template ({team_id}, {variant}=L|D). Leave unset for any
# public build: the logos are NBA Properties trademarks and no permission has been obtained (docs/dashboard.md).
# VITE_TEAM_LOGO_URL=
