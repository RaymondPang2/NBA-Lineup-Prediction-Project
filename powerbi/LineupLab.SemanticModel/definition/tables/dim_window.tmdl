/// The two date windows of each season, split at the All-Star break.
table dim_window
	lineageTag: d536fd82-da01-573a-afb0-6a9e6c7e49b0

	/// pre_asb or post_asb
	column window_type
		dataType: string
		isHidden
		lineageTag: 04e11396-b8d3-51f5-9844-ecb3c8438465
		summarizeBy: none
		sourceColumn: window_type

	/// Pre-break / Post-break
	column window_label
		dataType: string
		lineageTag: b361be8c-363a-52d0-877d-1e47a92c2fc6
		summarizeBy: none
		sourceColumn: window_label
		sortByColumn: window_order

	/// Sort key
	column window_order
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: f64436f1-86f1-50e5-bddb-95e8093f1403
		summarizeBy: none
		sourceColumn: window_order

	partition dim_window = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_window.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"window_type", type text}, {"window_label", type text}, {"window_order", Int64.Type}}, "en-US")
				in
				    Typed
